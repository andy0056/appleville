# Copy to .env.local and fill in. .env* is gitignored — never commit the real file.
#
#   cp .env.example .env.local
#
# Used to embed search queries for the Ask Appleville assistant. Optional:
# without it the assistant falls back to lexical retrieval, which still answers
# direct questions, just not paraphrased ones.
#
# The corpus itself is embedded at build time and committed, so this key is
# only needed for query-time embedding and for regenerating the corpus vectors.
OPENAI_API_KEY=
